# Supabase — 공개(publishable) 키. RLS로 보호되므로 클라이언트 노출 안전.
# Vercel 프로젝트 환경변수에도 동일하게 등록한다.
NEXT_PUBLIC_SUPABASE_URL=https://ymzlcghqamkynuvotzgh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_QZ9NGClQjBIuPWz7CR8_wA_Acv9anJQ

# === 서버 전용(클라이언트/깃에 절대 노출 금지) — /api/send-brochure 소개서 발송용 ===
# Supabase service_role 키(RLS 우회). Vercel 환경변수에만 등록.
SUPABASE_SERVICE_ROLE_KEY=
# 소개서 메일 발송 — (A) 서비스 계정 방식 권장 / (B) SMTP 앱비번 폴백. 발신 주소는 GMAIL_FROM.
GMAIL_FROM=noreply@supercoder.co
#
# (A) Google 서비스 계정 + 도메인 전체 위임 → Gmail API로 GMAIL_FROM 계정 위임 발송 (권장)
#   - GMAIL_SA_CLIENT_EMAIL: 서비스 계정 이메일 (xxx@yyy.iam.gserviceaccount.com)
#   - GMAIL_SA_PRIVATE_KEY : 서비스 계정 키(JSON)의 private_key 값. 줄바꿈은 \n 으로 한 줄로.
#   - 관리자 콘솔에서 서비스 계정 클라이언트ID에 scope https://www.googleapis.com/auth/gmail.send 도메인 전체 위임 필요
GMAIL_SA_CLIENT_EMAIL=
GMAIL_SA_PRIVATE_KEY=
#
# (B) Gmail SMTP + 앱 비밀번호 (앱비번이 허용될 때만)
#   - GMAIL_USER: 앱 비밀번호를 발급한 실제 로그인 계정
#   - GMAIL_APP_PASSWORD: 2단계 인증 후 발급한 16자리 앱 비밀번호
GMAIL_USER=
GMAIL_APP_PASSWORD=

# === 서버 전용 — 일일 애널리틱스 리포트의 GA4 포착률 판정용 ===
# Vercel Web Analytics(쿠키리스 실측)에서 어제 방문자 수를 읽어 GA4 포착률의 분모로 쓴다.
# 없으면 포착률이 '참고·조회수 기준'으로만 표시된다(경보는 나가지 않음).
#   - 발급: Vercel 대시보드 → Account Settings → Tokens (스코프는 해당 팀, 읽기 전용으로 충분)
#   - VERCEL_PROJECT_ID / VERCEL_TEAM_ID 는 코드에 기본값이 있어 보통 생략 가능
VERCEL_ANALYTICS_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
